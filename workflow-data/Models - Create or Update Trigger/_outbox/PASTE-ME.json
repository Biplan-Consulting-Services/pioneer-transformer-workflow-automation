{
  "$schema": "https://power-automate-tools.local/flow-editor.json#",
  "connectionReferences": {
    "shared_sharepointonline": {
      "connectionName": "shared-sharepointonl-98111a58-3176-47a5-919a-054d39a7c684",
      "connectionReferenceLogicalName": "new_sharedsharepointonline_89e9a",
      "source": "Embedded",
      "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "displayName": "SharePoint",
      "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1813/1.0.1813.4769/sharepointonline/icon.png",
      "brandColor": "",
      "tier": "Standard",
      "apiName": "sharepointonline",
      "isProcessSimpleApiReferenceConversionAlreadyDone": false
    }
  },
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "When_an_item_is_created_or_modified": {
        "type": "OpenApiConnection",
        "recurrence": {
          "interval": 1,
          "frequency": "Minute"
        },
        "inputs": {
          "parameters": {
            "dataset": "https://ermcopower.sharepoint.com/sites/PioneerPlanificatio",
            "table": "b43a5140-0f9d-4ac1-9019-43b897074224"
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "operationId": "GetOnUpdatedItems",
            "connectionName": "shared_sharepointonline"
          }
        },
        "splitOn": "@triggerOutputs()?['body/value']"
      }
    },
    "actions": {
      "Get_units_of_this_parent": {
        "runAfter": {},
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "dataset": "https://ermcopower.sharepoint.com/sites/PioneerPlanificatio",
            "table": "d6468ec5-c7b5-44a3-8ce0-f81f059b671d",
            "$filter": "ModelId eq @{triggerOutputs()?['body/ID']}",
            "$top": 5000
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "operationId": "GetItems",
            "connectionName": "shared_sharepointonline"
          }
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
            "minimumItemCount": 5000
          }
        }
      },
      "Apply_to_each_unit": {
        "foreach": "@outputs('Get_units_of_this_parent')?['body/value']",
        "runAfter": {
          "Get_units_of_this_parent": [
            "Succeeded"
          ]
        },
        "type": "Foreach",
        "actions": {
          "needsUpdate": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@or(\n  not(equals(coalesce(items('Apply_to_each_unit')?['MdlEstimatedEffort'], ''), coalesce(triggerOutputs()?['body/Estimated_x0020_Effort'], ''))),\n  not(equals(coalesce(items('Apply_to_each_unit')?['MdlLatestModelRevision'], ''), coalesce(triggerOutputs()?['body/ModelRevision']?['Value'], ''))),\n  not(equals(coalesce(items('Apply_to_each_unit')?['MdlModelID'], ''), coalesce(triggerOutputs()?['body/ModelID'], ''))),\n  not(equals(coalesce(items('Apply_to_each_unit')?['MdlModificationStatus'], ''), coalesce(triggerOutputs()?['body/ModificationStatus']?['Value'], ''))),\n  not(equals(coalesce(items('Apply_to_each_unit')?['MdlParentModel'], ''), coalesce(triggerOutputs()?['body/ParentModel']?['Value'], '')))\n)"
          },
          "Only_if_something_changed": {
            "runAfter": {
              "needsUpdate": [
                "Succeeded"
              ]
            },
            "type": "If",
            "expression": {
              "equals": [
                "@outputs('needsUpdate')",
                true
              ]
            },
            "actions": {
              "Update_unit": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://ermcopower.sharepoint.com/sites/PioneerPlanificatio",
                    "table": "d6468ec5-c7b5-44a3-8ce0-f81f059b671d",
                    "id": "@items('Apply_to_each_unit')?['ID']",
                    "item/MdlEstimatedEffort": "@triggerOutputs()?['body/Estimated_x0020_Effort']",
                    "item/MdlLatestModelRevision": "@triggerOutputs()?['body/ModelRevision']?['Value']",
                    "item/MdlModelID": "@triggerOutputs()?['body/ModelID']",
                    "item/MdlModificationStatus": "@triggerOutputs()?['body/ModificationStatus']?['Value']",
                    "item/MdlParentModel": "@triggerOutputs()?['body/ParentModel']?['Value']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "PatchItem",
                    "connectionName": "shared_sharepointonline"
                  }
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  }
}
