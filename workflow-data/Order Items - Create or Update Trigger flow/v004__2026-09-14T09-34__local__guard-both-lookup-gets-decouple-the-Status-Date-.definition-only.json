      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "vStatusDateValue",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Condition_StatusDate": {
      "actions": {
        "Set_vStatusDateValue": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "64add890-98cb-4193-825b-8df82b122433"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "vStatusDateValue",
            "value": "@formatDateTime(convertFromUtc(utcNow(), 'Eastern Standard Time'), 'yyyy-MM-dd')"
          }
        },
        "Set_vUpdateOrderItem_StatusDate": {
          "runAfter": {
            "Set_vStatusDateValue": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7da6afcc-751c-4655-87ab-28aff48bd188"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "vUpdateOrderItem",
            "value": true
          }
        }
      },
      "runAfter": {
        "Initialize_vStatusDateValue": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
