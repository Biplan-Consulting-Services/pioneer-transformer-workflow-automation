              ]
            }
          },
          {
            "not": {
              "equals": [
                "@triggerBody()?['StepStatus/Value']",
                ""
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@coalesce(triggerBody()?['StepStatus/Value'], '')",
                "@coalesce(triggerBody()?['StepStatusStamped'], '')"
              ]
            }
          }
        ]
      },
      "metadata": {
        "operationMetadataId": "f5fab5a0-36ae-41c8-b3e1-1262f2dbb772"
      },
      "type": "If"
    },
    "Guard_Client": {
      "type": "If",
      "runAfter": {
