              "item/Order_Number_TextField": "@triggerBody()?['OrderNumber/Value']",
              "item/Client_ID_TextField": "@coalesce(outputs('Get_Client')?['body/Client_ID'], triggerBody()?['Client_ID_TextField'])",
              "item/Model_ID_TextField": "@coalesce(outputs('Get_Model')?['body/ModelID'], triggerBody()?['Model_ID_TextField'])",
              "item/Model_Revision_ID_TextField": "@triggerBody()?['ModelRevision/Value']",
              "item/StepStatusStamped": "@triggerBody()?['StepStatus/Value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "runAfter": {
        "Condition": [
          "Succeeded"
        ],
        "Condition_StatusDate": [
          "Succeeded"
        ]
      },
      "expression": {
        "or": [
          {
            "equals": [
