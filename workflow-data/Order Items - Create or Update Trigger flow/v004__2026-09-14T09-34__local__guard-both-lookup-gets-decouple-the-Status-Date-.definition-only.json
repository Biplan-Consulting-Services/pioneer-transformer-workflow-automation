      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@coalesce(triggerBody()?['Client/Id'], '')",
                ""
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@coalesce(triggerBody()?['Client/Id'], 0)",
                0
              ]
            }
          }
        ]
      },
      "actions": {
        "Get_Client": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "ba5a0dc7-1cca-45af-bc5a-e3ddbbca7e99"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
