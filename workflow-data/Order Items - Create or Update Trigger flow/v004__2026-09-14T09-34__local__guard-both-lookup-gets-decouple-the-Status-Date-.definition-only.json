          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e444e45a-0950-4717-aa2d-51ba6d69fe4f"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://ermcopower.sharepoint.com/sites/PioneerPlanificatio",
              "table": "b43a5140-0f9d-4ac1-9019-43b897074224",
              "id": "@triggerBody()?['Model/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    }
  },
  "outputs": {}
}
