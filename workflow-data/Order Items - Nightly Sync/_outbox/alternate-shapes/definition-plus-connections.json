      "tier": "NotSpecified",
      "apiName": "sharepointonline",
      "isProcessSimpleApiReferenceConversionAlreadyDone": false,
      "connectionReferenceLogicalName": "new_sharedsharepointonline_89e9a"
    },
    "shared_excelonlinebusiness": {
      "connectionName": "shared-excelonlinebu-2cd3888f-e062-4556-9eda-e80966dc0ad6",
      "source": "Embedded",
      "id": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
      "tier": "NotSpecified",
      "apiName": "excelonlinebusiness",
      "isProcessSimpleApiReferenceConversionAlreadyDone": false,
      "connectionReferenceLogicalName": "new_sharedexcelonlinebusiness_452b5"
    }
  }
}
