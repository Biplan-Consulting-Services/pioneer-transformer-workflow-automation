const FEATURES_TABLE_NAME = "TableScriptFeatures";
const SCRIPT_STATUS_CELL = "ScriptStatusCell";
const TOTAL_STEPS = 11;

// Bounds the step 7 refresh wait so a desynced query cannot hang the script indefinitely.
const REFRESH_TIMEOUT_SECONDS = 600;
const REFRESH_POLL_SECONDS = 5;

// Live runs print failures and warnings only. Set VERBOSE to true while debugging to also
// see the per-column progress lines (date formats restored, date text converted, ...).
const VERBOSE = false;

function debug(message: string) {
    if (VERBOSE) {
        console.log(message);
    }
}

interface Features {
    conserveFormulas: boolean;
    conserveUniqueFormats: boolean;
    tryResolveOverflows: boolean;
    tryEnforceFormat: boolean;
    reevalFormulas: boolean;
}

interface TreatableTable {
    tableName: string;
}

interface TreateableWorksheet {
    sheet: ExcelScript.Worksheet;
    tables: TreatableTable[];
    options?: Partial<ExcelScript.WorksheetProtectionOptions>;
}

function main(workbook: ExcelScript.Workbook) {
    const startTime = new Date();
    const application = workbook.getApplication();
    const statusCell = workbook.getNamedItem(SCRIPT_STATUS_CELL).getRange();
    let treateableWorksheets = gatherAndClearSheetConfigurations(workbook);

    displayStatus("Starting update", statusCell);

    const exclusionList = getTableContents(workbook, "ReevExclusionList", "Tables");

    application.setCalculationMode(ExcelScript.CalculationMode.manual);

    displayStatus(`Step 1/${TOTAL_STEPS}: Parsing features for refresh.`, statusCell);
    const features = tryParseFeaturesTable(workbook);

    displayStatus(`Step 2/${TOTAL_STEPS}: Saving comments.`, statusCell);
    // let commentTables = getPresavedTableData(workbook);

    displayStatus(`Step 3/${TOTAL_STEPS}: Temporarily removing comments in tables`, statusCell);
    // deleteCommentsInTables(workbook, commentTables);

    displayStatus(`Step 4/${TOTAL_STEPS}: Preparing file for refresh.`, statusCell);


    if (features.tryEnforceFormat) {
        displayStatus(`Step 5/${TOTAL_STEPS}: Preparing format enforcement table.`, statusCell);
        arrangeDataFormatTable(workbook);
    } else {
        displayStatus(`Step 6/${TOTAL_STEPS}: Skipping format enforcement step.`, statusCell);
    }

    displayStatus(`Step 7/${TOTAL_STEPS}: Refreshing external data.`, statusCell);
    refreshQueriesAndWaitForCompletion(workbook, statusCell);

    displayStatus(`Step 8/${TOTAL_STEPS}: Forcing reevaluation of cell types (necessary for mixed types).`, statusCell);

    if (features.reevalFormulas) {
        reevaluateDesignatedFormulas(workbook);
    }

    // Re-assert the date formats every run. getValues() hands dates back as serial numbers,
    // so the reevaluation below writes numbers into the date columns - which display as
    // 45xxx rather than a date if the column's format was lost by an earlier failed sync.
    // Enforcing the format here closes that loop instead of leaving it to be noticed later.
    enforceDateFormats(workbook);

    // Turn date TEXT back into real dates ourselves, before the generic rewrite below. That
    // rewrite only coerces ISO dates (see ISO_DATE_TEXT), so a refresh that hands back
    // "2/20/2024 12:00:00 AM" or "9/24/2026" left them as text (2026-09-27: all 15 date
    // columns of Archive FRM10-12). See convertDateTextToDates.
    convertDateTextToDates(workbook, exclusionList);

    // Report (never fix) any drift in the three tables other workbooks read. Failures only.
    checkLegacyShapes(workbook);

    treateableWorksheets.forEach(treatableWorksheet => {
        treatableWorksheet.tables.forEach(treatableTable => {
            if (exclusionList.includes(treatableTable.tableName)) {
                return;
            }

            let table = treatableWorksheet.sheet.getTable(treatableTable.tableName);

            if (features.conserveFormulas) {
                reevaluateCellsWithFormulas(table);
            } else {
                reevaluateCells(table);
            }
        });
    });

    if (features.tryResolveOverflows) {
        displayStatus(`Step 9/${TOTAL_STEPS}: Attempting to resolve data overflows.`, statusCell);
        treateableWorksheets.forEach(treatableWorksheet => {
            treatableWorksheet.tables.forEach(treatableTable => {
                let table = treatableWorksheet.sheet.getTable(treatableTable.tableName);
                detectAndResolveOverflows(table);
            });
        });
    } else {
        displayStatus(`Step 9/${TOTAL_STEPS}: Skipping overflow resolution.`, statusCell);
    }

    displayStatus(`Step 10/${TOTAL_STEPS}: Restoring Comments`, statusCell);
    // restoreComments(workbook, commentTables);

    displayStatus(`Step 11/${TOTAL_STEPS}: Restoring sheet and table configuration.`, statusCell);

    application.calculate(ExcelScript.CalculationType.recalculate);
    application.calculate(ExcelScript.CalculationType.fullRebuild);
    application.setCalculationMode(ExcelScript.CalculationMode.automatic);

    const endTime = new Date();
    const diffMs = endTime.getTime() - startTime.getTime();
    const diffMinutes = Math.floor(diffMs / 60000);
    const diffSeconds = Math.floor((diffMs % 60000) / 1000);

    displayStatus(`Update done, finished at ${endTime}, ${diffMinutes}:${diffSeconds} mins elapsed.`, statusCell);
    reapplySheetConfigurations(treateableWorksheets);
}

function reevaluateDesignatedFormulas(workbook: ExcelScript.Workbook) {
    const controlTable = workbook.getTable("TableReevalColumns");
    const header = controlTable.getHeaderRowRange().getValues()[0] as string[];
    const data = controlTable.getRangeBetweenHeaderAndTotal().getValues();

    const tableColIdx = header.indexOf("Table to Reevaluate");
    const columnColIdx = header.indexOf("Column Name");

    for (const row of data) {
        const tableName = row[tableColIdx]?.toString().trim();
        const columnName = row[columnColIdx]?.toString().trim();

        if (!tableName || !columnName) continue;

        const table = workbook.getTable(tableName);
        const column = table.getColumnByName(columnName);
        const range = column.getRangeBetweenHeaderAndTotal();

        debug(`Reevaling ${columnName} from ${tableName}`);

        range.replaceAll("=", "==", {
            completeMatch: false,
            matchCase: false
        });

        range.replaceAll("==", "=", {
            completeMatch: false,
            matchCase: false
        });

        workbook.getApplication().calculate(ExcelScript.CalculationType.recalculate);
    }
}

function getTableContents(
    workbook: ExcelScript.Workbook,
    tableName: string,
    columnName: string
): string[] {
    const table = workbook.getTable(tableName);

    if (!table) {
        return [];
    }

    const column = table.getColumnByName(columnName);
    const values = column.getRange().getValues();

    return values.map(row => row[0]?.toString() ?? "");
}

// A type reevaluation can only ever change a cell holding TEXT that a rewrite would coerce
// to some other type. Which shapes those are is decided by the PARSER doing the coercion -
// and setValues()/setFormulas() parse with the locale-invariant (en-US) rules, not the
// workbook's. These workbooks run French (fr-CA), so those are not the same parser, and most
// of what "looks coercible" to a French reader is inert to the one actually running.
//
// Narrowed 2026-09-03 (user decision) from a predicate that tested three broad shapes.
// What survives - genuinely coerced by the invariant parser:
//
//   ISO date        "2026-08-15"    Excel accepts the ISO form in every locale.
//   English boolean "TRUE"/"FALSE"  Excel's stored boolean literals are English.
//
// What was dropped, and why each is a no-op rather than a regression:
//
//   comma-decimal   "21930,34"      Invariant parsing wants "." as the decimal separator,
//                                   so this stays text. It was the single biggest source of
//                                   rewrites (Price, ~2,965 cells) and changed nothing.
//   French boolean  "VRAI"/"FAUX"   Not boolean literals to the invariant parser.
//   slash/dot date  "15/08/2026"    Invariant parsing reads m/d/y, so a fr-CA d/m/y value
//                                   either fails (day > 12) or silently becomes the WRONG
//                                   date. Excluding it is a correctness fix, not just a
//                                   saving - the old DATE_TEXT matched these.
//
// Cost of the old breadth: ~51,200 archive cells rewritten per run that never change. Each
// bulk write lands in a table that may be query-bound, which is the desync mechanism in
// CONTEXT.md (2026-08-28) - so the breadth was buying risk, not safety.
//
// Deliberately still no numeric shape at all. A dot-decimal ("74281.69") WOULD coerce under
// invariant parsing, but no column in these workbooks stores one: a scan of the viewer
// workbook's 2,468 shared strings on 2026-09-03 found 25 comma-decimals and zero
// dot-decimals, zero ISO-date text, and zero boolean text of either language. If a
// dot-decimal column ever appears, add it here - do not widen the date or boolean tests.
const ISO_DATE_TEXT = /^\d{4}-\d{1,2}-\d{1,2}$/;
const ENGLISH_BOOLEAN_TEXT = /^(true|false)$/i;

function isCoercibleText(value: string | number | boolean): boolean {
    if (typeof value !== "string") {
        return false;
    }

    const stripped = value.replace(/[\s\u00a0$]/g, "");

    if (stripped.length === 0) {
        return false;
    }

    return ISO_DATE_TEXT.test(stripped) || ENGLISH_BOOLEAN_TEXT.test(stripped);
}

// Indexes of the columns worth rewriting. Restricting the write to these is
// behaviour-preserving by construction: every column left alone contains nothing a rewrite
// could alter.
function findColumnsNeedingReevaluation(grid: (string | number | boolean)[][], includeFormulas: boolean): number[] {
    if (grid.length === 0) {
        return [];
    }

    const columnCount = grid[0].length;
    const targets: number[] = [];

    for (let col = 0; col < columnCount; col++) {
        for (let row = 0; row < grid.length; row++) {
            const cell = grid[row][col];
            const isFormula = includeFormulas && typeof cell === "string" && cell.charAt(0) === "=";

            if (isFormula || isCoercibleText(cell)) {
                targets.push(col);
                break;
            }
        }
    }

    return targets;
}

// Saving and restoring per-column filter criteria costs two API round-trips per column - 96
// on TableArchiveFRM10_12, 82 on TableOrders. Skip the whole dance when nothing is filtered.
function withFiltersPreserved(table: ExcelScript.Table, action: () => void) {
    const wasFiltered = table.getAutoFilter().getIsDataFiltered();
    let columnFilters: ExcelScript.FilterCriteria[] = [];

    if (wasFiltered) {
        columnFilters = table.getColumns().map(column => column.getFilter().getCriteria());
        table.clearFilters();
    }

    action();

    if (wasFiltered) {
        table.getColumns().forEach((column, index) => {
            const criteria = columnFilters[index];
            if (criteria) {
                column.getFilter().apply(criteria);
            }
        });
    }
}

// Every date column, and the one format they should all carry. The 2026-08-29 16:23 repair
// reset all of them to "General" and the hand-repair afterwards was partial - five columns
// were still stranded on "mm-dd-yy" (Excel's US default, what a cell reverts to when its
// explicit format is lost) a full three days later. Re-asserting on every refresh means a
// failed sync costs a display glitch until the next run, not a manual hunt.
//
// The ";@" section is deliberate: it renders text as text instead of coercing it. Several
// date columns legitimately carry text markers - Coiling Date holds 9 "EC" placeholders.
const DATE_FORMAT = "yyyy\\-mm\\-dd;@";

const DATE_COLUMNS = [
    "Order Date",
    "Ing. Due Date",
    "Initial Promised Date",
    "Estimated Delivery Date",
    "Coiling Date",
    "Stacking Date",
    "Assembly Date",
    "Drying Date",
    "Tanking Date",
    "Testing Date",
    "Finishing Date",
    "Delivery Date",
    "Tank Delivery Date",
    "Original Tanking Date",
    "Manual Estimated Delivery Date",
    "Client Desired Date",
];

// Columns whose NAME contains "date" but which hold free text. Never reformatted.
const TEXT_COLUMNS_WITH_DATE_IN_NAME = [
    "Client Date Status",
    "Tanking date change justification",
    "Tanking Date Status",
    "Tanking Date Change Justification",
];

// Excel is inconsistent about escaping literal characters in format codes, so compare on the
// unescaped form rather than re-applying a correct format on every run.
function normaliseFormat(format: string): string {
    return format.replace(/\\/g, "").toLowerCase();
}

function enforceDateFormats(workbook: ExcelScript.Workbook) {
    const wantedNormalised = normaliseFormat(DATE_FORMAT);
    let fixed = 0;

    for (const table of workbook.getTables()) {
        const body = table.getRangeBetweenHeaderAndTotal();

        if (body.getRowCount() === 0) {
            continue;
        }

        const headers = table.getHeaderRowRange().getValues()[0];

        headers.forEach((header, columnIndex) => {
            const name = header === null ? "" : header.toString().trim();

            if (name.length === 0) {
                return;
            }

            if (TEXT_COLUMNS_WITH_DATE_IN_NAME.indexOf(name) !== -1) {
                return;
            }

            if (DATE_COLUMNS.indexOf(name) === -1) {
                return;
            }

            const columnRange = body.getColumn(columnIndex);

            // The top-left cell is enough to spot a column that has reverted, and far
            // cheaper than reading every cell.
            const current = columnRange.getCell(0, 0).getNumberFormat();

            if (normaliseFormat(current) === wantedNormalised) {
                return;
            }

            // setNumberFormat, NOT setNumberFormatLocal: the code above is the invariant
            // (English) one Excel stores. This workbook runs in a French locale, where the
            // Local variant would expect "aaaa-mm-jj" and silently mangle it.
            columnRange.setNumberFormat(DATE_FORMAT);
            fixed++;
            debug(`Date format restored on ${table.getName()}.${name} (was "${current}")`);
        });
    }

    if (fixed > 0) {
        debug(`Re-asserted the date format on ${fixed} column(s).`);
    }
}

// ---------------------------------------------------------------------------------------
// Date text -> real dates, locale-proof.
//
// Found 2026-09-27. After a refresh, date columns can arrive as TEXT in two shapes:
//   "2/20/2024 12:00:00 AM"   US month/day/year with a time: history rows re-read by the query
//   "9/24/2026"               bare slash date: new rows from the FRM10-12 viewer
// The generic rewrite coerces neither: ISO_DATE_TEXT is deliberately ISO-only, because
// setValues() parses with the invariant (m/d/y) rules and a fr-CA d/m/y slash date would
// silently become the WRONG date. That exclusion is right, and it must stay.
//
// So this parses the text itself, deciding month/day per column instead of assuming m/d/y,
// and writes Excel serial numbers, which mean the same thing on every machine:
//   ISO "2026-09-24" (optionally with a time)        -> year-month-day, never ambiguous
//   "M/D/YYYY h:mm[:ss] AM|PM"                       -> month/day: AM/PM is the US signature
//   bare "a/b/YYYY"                                  -> order decided PER COLUMN from its own
//                                                       unambiguous values (a part above 12, or
//                                                       an AM/PM value). A column that cannot
//                                                       decide leaves those cells as text and
//                                                       logs them. It never guesses.
// Anything else (EC markers, free text, blanks, real dates) is left exactly as it was.
//
// Columns: DATE_COLUMNS plus any header containing "date" (the archive's French FRM11 columns,
// "Last Synchronisation Date"), minus TEXT_COLUMNS_WITH_DATE_IN_NAME. Only date-SHAPED text is
// ever rewritten, so the wider net cannot touch free text.
const ISO_DATE_PARSE = /^(\d{4})-(\d{1,2})-(\d{1,2})(?:[T ](\d{1,2}):(\d{2})(?::(\d{2}))?(?:\.\d+)?Z?)?$/;
const US_DATETIME_TEXT = /^(\d{1,2})\/(\d{1,2})\/(\d{4}) (\d{1,2}):(\d{2})(?::(\d{2}))? ?([AP]M)$/i;
const BARE_SLASH_DATE_TEXT = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/;

function toSerial(y: number, m: number, d: number, hh: number, mm: number, ss: number): number | null {
    if (m < 1 || m > 12 || d < 1 || d > 31 || hh > 23 || mm > 59 || ss > 59) {
        return null;
    }
    const ms = Date.UTC(y, m - 1, d, hh, mm, ss);
    const check = new Date(ms);
    // Rejects 2/30 and the like, which Date.UTC would silently roll into March.
    if (check.getUTCFullYear() !== y || check.getUTCMonth() !== m - 1 || check.getUTCDate() !== d) {
        return null;
    }
    return ms / 86400000 + 25569;   // 25569 = serial of 1970-01-01 in Excel's 1900 system
}

function isDateColumnName(name: string): boolean {
    if (TEXT_COLUMNS_WITH_DATE_IN_NAME.indexOf(name) !== -1) {
        return false;
    }
    return DATE_COLUMNS.indexOf(name) !== -1 || name.toLowerCase().indexOf("date") !== -1;
}

// "MD" = month first, "DM" = day first, null = this column cannot tell.
function slashOrderForColumn(values: (string | number | boolean)[]): string | null {
    let md = 0;
    let dm = 0;
    for (const v of values) {
        if (typeof v !== "string") {
            continue;
        }
        const t = v.trim();
        if (US_DATETIME_TEXT.test(t)) {
            md++;
            continue;
        }
        const b = BARE_SLASH_DATE_TEXT.exec(t);
        if (b) {
            const first = Number(b[1]);
            const second = Number(b[2]);
            if (first > 12 && second <= 12) {
                dm++;
            } else if (second > 12 && first <= 12) {
                md++;
            }
        }
    }
    if (md > 0 && dm === 0) {
        return "MD";
    }
    if (dm > 0 && md === 0) {
        return "DM";
    }
    return null;
}

function parseDateText(v: string, order: string | null): number | null {
    const t = v.trim();
    let m = ISO_DATE_PARSE.exec(t);
    if (m) {
        return toSerial(Number(m[1]), Number(m[2]), Number(m[3]),
            Number(m[4] || 0), Number(m[5] || 0), Number(m[6] || 0));
    }
    m = US_DATETIME_TEXT.exec(t);
    if (m) {
        let hh = Number(m[4]) % 12;
        if (m[7].toUpperCase() === "PM") {
            hh += 12;
        }
        return toSerial(Number(m[3]), Number(m[1]), Number(m[2]), hh, Number(m[5]), Number(m[6] || 0));
    }
    m = BARE_SLASH_DATE_TEXT.exec(t);
    if (m && order) {
        const a = Number(m[1]);
        const b = Number(m[2]);
        return order === "MD" ? toSerial(Number(m[3]), a, b, 0, 0, 0) : toSerial(Number(m[3]), b, a, 0, 0, 0);
    }
    return null;
}

function convertDateTextToDates(workbook: ExcelScript.Workbook, exclusionList: string[]) {
    let convertedTotal = 0;

    for (const table of workbook.getTables()) {
        if (exclusionList.includes(table.getName())) {
            continue;
        }
        const body = table.getRangeBetweenHeaderAndTotal();
        if (body.getRowCount() === 0) {
            continue;
        }
        const headers = table.getHeaderRowRange().getValues()[0];

        headers.forEach((header, columnIndex) => {
            const name = header === null ? "" : header.toString().trim();
            if (name.length === 0 || !isDateColumnName(name)) {
                return;
            }

            const columnRange = body.getColumn(columnIndex);
            const grid = columnRange.getValues();
            const flat = grid.map(r => r[0]);

            // Cheap exit: nothing in this column is text at all.
            if (!flat.some(v => typeof v === "string" && v.trim().length > 0)) {
                return;
            }

            const order = slashOrderForColumn(flat);
            let converted = 0;
            let undecided = 0;
            const out = grid.map(r => {
                const v = r[0];
                if (typeof v !== "string" || v.trim().length === 0) {
                    return [v];
                }
                const serial = parseDateText(v, order);
                if (serial === null) {
                    if (BARE_SLASH_DATE_TEXT.test(v.trim())) {
                        undecided++;
                    }
                    return [v];
                }
                converted++;
                return [serial];
            });

            if (undecided > 0) {
                console.log(`${table.getName()}.${name}: ${undecided} slash date(s) left as text - the column has no unambiguous value to tell month/day from day/month.`);
            }
            if (converted === 0) {
                return;
            }

            withFiltersPreserved(table, () => {
                columnRange.setValues(out);
            });
            // A converted column must display as a date, including ones outside DATE_COLUMNS.
            columnRange.setNumberFormat(DATE_FORMAT);
            convertedTotal += converted;
            debug(`${table.getName()}.${name}: ${converted} date text value(s) converted to dates.`);
        });
    }

    if (convertedTotal > 0) {
        debug(`Converted ${convertedTotal} date text value(s) to real dates.`);
    }
}

