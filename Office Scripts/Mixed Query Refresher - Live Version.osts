function sameList(a: string[], b: string[]): boolean {
    return a.length === b.length && a.every((v, i) => v === b[i]);
}

function describeDrift(actual: string[], pinned: string[]): string {
    const missing = pinned.filter(c => actual.indexOf(c) === -1);
    const extra = actual.filter(c => pinned.indexOf(c) === -1);
    const parts: string[] = [];
    if (missing.length > 0) {
        parts.push(`missing: ${missing.slice(0, 5).join(", ")}${missing.length > 5 ? "..." : ""}`);
    }
    if (extra.length > 0) {
        parts.push(`unexpected: ${extra.slice(0, 5).join(", ")}${extra.length > 5 ? "..." : ""}`);
    }
    if (parts.length === 0) {
        const at = actual.findIndex((v, i) => v !== pinned[i]);
        parts.push(`column order changed at position ${at + 1} ("${actual[at]}" where "${pinned[at]}" is expected)`);
    }
    return parts.join("; ");
}

function checkLegacyShapes(workbook: ExcelScript.Workbook) {
    const problems: string[] = [];
    const expected: { name: string, shapes: string[][] }[] = [
        { name: "TableArchiveFRM10_12", shapes: [PINNED_FRM10_12, PINNED_FRM10_12.concat(PINNED_FRM10_12_BO)] },
        { name: "TableArchiveFRM11", shapes: [PINNED_FRM11] },
        { name: "TableArchiveFRM13", shapes: [PINNED_FRM13] },
    ];

    for (const e of expected) {
        const table = workbook.getTable(e.name);
        if (!table) {
            problems.push(`${e.name} is missing`);
            continue;
        }
        const headers = (table.getHeaderRowRange().getValues()[0] as (string | number | boolean)[])
            .map(h => h === null ? "" : h.toString());
        if (!e.shapes.some(shape => sameList(headers, shape))) {
            // Describe against the closest pinned shape, so a 93-column drift doesn't also list the 18 BO columns.
            const closest = e.shapes.reduce((a, b) =>
                Math.abs(b.length - headers.length) < Math.abs(a.length - headers.length) ? b : a);
            problems.push(`${e.name} header drift: ${describeDrift(headers, closest)}`);
        }

        // A convertible DATE left as text after the converter ran = a type break (the 09-27
        // incident). Legacy placeholders are real data and are NOT reported: "EC", "TBD", "HOLD",
        // "2025-99-99", "pickup 2025-01-06"... Only text that parses as a valid date counts, plus
        // slash dates the converter could not order (month/day undecided).
        const body = table.getRangeBetweenHeaderAndTotal();
        if (body.getRowCount() === 0) {
            continue;
        }
        headers.forEach((name, columnIndex) => {
            if (!isDateColumnName(name)) {
                return;
            }
            const values = body.getColumn(columnIndex).getValues();
            let textCount = 0;
            let example = "";
            for (const row of values) {
                const v = row[0];
                if (typeof v === "string" && (parseDateText(v, "MD") !== null || BARE_SLASH_DATE_TEXT.test(v.trim()))) {
                    textCount++;
                    if (example === "") {
                        example = v;
                    }
                }
            }
            if (textCount > 0) {
                problems.push(`${e.name}.${name}: ${textCount} text value(s) in a date column, e.g. "${example}"`);
            }
        });
    }

    if (problems.length > 0) {
        console.log(`LEGACY ARCHIVE SHAPE CHECK FAILED (${problems.length}):\n  ` + problems.join("\n  "));
    }
}

function reevaluateCells(table: ExcelScript.Table) {
    const range = table.getRangeBetweenHeaderAndTotal();

    // Reads are comparatively cheap; it is the write-back that costs. So read the body once,
    // then write only the columns that can actually change.
    //
    // Measured across the live workbook and the archive (971,017 cells in the date-bearing
    // tables), targeting cuts the write to about a tenth:
    //   Archive FRM10-12    14 of 96 columns ->  71,680 of 491,520 cells
    //   Archive FRM11        5 of 39 columns ->  20,265 of 158,067 cells
    //   Archive FRM13        2 of 55 columns ->   2,610 of  71,775 cells
    //   TableOrders (live)   3 of 82 columns ->   3,117 of  85,198 cells
    //   Archive BO / Cedule_Production / Fournisseurs_Cuve
    //                        nothing coercible ->     0 of 164,457 cells
    //
    // Those last three are a pure no-op: ~164k cells read and written back to change nothing.
    // Beyond the time, each is a bulk write into a table that may be query-bound, which is
    // the desync mechanism described in CONTEXT.md (2026-08-28).
    const values = range.getValues();
    const targets = findColumnsNeedingReevaluation(values, false);

    if (targets.length === 0) {
        return;
    }

    withFiltersPreserved(table, () => {
        for (const col of targets) {
            const columnRange = range.getColumn(col);
            columnRange.setValues(columnRange.getValues());
        }
    });
}

function reevaluateCellsWithFormulas(table: ExcelScript.Table) {
    const range = table.getRangeBetweenHeaderAndTotal();

    // Same targeting as reevaluateCells, plus the columns carrying formulas. On TableOrders
    // that is 6 formula columns of 82 (Price, Estimated Delivery Date, Price CAD, Price USD,
    // Navigation Order, Navigation Model) - 6,234 cells instead of 85,198.
    //
    // The other 76 columns are Power Query output. Writing them back is not just wasted
    // payload: it is a bulk write into a query-bound ListObject immediately after step 7
    // refreshed it, which is exactly the collision behind the 2026-08-28 binding corruption
    // (three trailing columns renamed to Column1/2/3, SourceType dropping to xlSrcRange).
    const formulas = range.getFormulas();
    const targets = findColumnsNeedingReevaluation(formulas, true);

    if (targets.length === 0) {
        return;
    }

    withFiltersPreserved(table, () => {
        for (const col of targets) {
            const columnRange = range.getColumn(col);
            try {
                columnRange.setFormulas(columnRange.getFormulas());
            } catch (error) {
                console.log(`Reevaluation failed on column index ${col}: ${error}`);
            }
        }
    });
}

function detectAndResolveOverflows(table: ExcelScript.Table) {
    let range = table.getRangeBetweenHeaderAndTotal(); // Get the entire table range

    const overflowDisplay = "###############################################################################################################################################################################################################################################################"

    const findIndexes = (arr: string[], searchTerm: string) => arr.reduce((acc, str, i) => str.includes(searchTerm) ? [...acc, i] : acc, []);

    let texts = range.getTexts();
    let types = range.getValues().map(r => r.map(rc => typeof rc));
    let values = range.getValues();

    let rowCount = texts.length;
    let columnCount = texts[0].length;

    for (let row = 0; row < rowCount; row++) {
        let potentialOverflowIndexes: number[] = findIndexes(texts[row], overflowDisplay);

        for (let i = 0; i < potentialOverflowIndexes.length; ++i) {
            let potentialOverflowIndex = potentialOverflowIndexes[i];
            let cellType = types[row][potentialOverflowIndex];

            if (cellType === 'number') {
                range.getCell(row, potentialOverflowIndex).setNumberFormat("General");
            }
        }
    }
}

function arrangeDataFormatTable(workbook: ExcelScript.Workbook) {
    const table = workbook.getTable("TableFormatParser");

    if (!table) {
        console.log("Table 'TableFormatParser' does not exist.");
        return;
    }

    const requiredColumns = ["Data", "Type", "Enforced Characteristics", "Display Characteristics"];
    const headers = table.getHeaderRowRange().getValues()[0];
    if (!requiredColumns.every(col => headers.includes(col))) {
        console.log("The required columns are not present.");
        return;
    }

    let typeColumn = table.getColumnByName("Type").getRangeBetweenHeaderAndTotal().getValues();
    let dataColumn = table.getColumnByName("Data").getRangeBetweenHeaderAndTotal();
    let displayCharColumn = table.getColumnByName("Display Characteristics").getRangeBetweenHeaderAndTotal();

    for (let i = 0; i < typeColumn.length; i++) {
        if (typeColumn[i][0] === "Number") {
            const testValue = 100000.75;
            const defaultDecimalSeparator = ".";
            // Get the number from "Data" and its display value
            let dataCell = dataColumn.getCell(i, 0);
            dataCell.setValue(testValue);
            let displayValue = dataCell.getText();
            let actualValue = dataCell.getValue();
            let actualValueStr = actualValue.toString();

            // Analyze the display value to determine digit group and decimal separators
            let digitGroupSeparator: string = "";
            let decimalSeparator: string = defaultDecimalSeparator;
            let decimalSeparatorOffset = -(actualValueStr.length) + actualValueStr.indexOf(defaultDecimalSeparator);

            decimalSeparator = displayValue.substr(decimalSeparatorOffset, 1);

            let displayValueBeforeDecimal = displayValue.substr(0, displayValue.lastIndexOf(decimalSeparator));
            let actualValueBeforeDecimal = actualValueStr.substr(0, actualValueStr.lastIndexOf(defaultDecimalSeparator))
            const possibleDigitGroupSeparators = [" ", ","];

            for (let separator of possibleDigitGroupSeparators) {
                if (displayValueBeforeDecimal.includes(separator)) {
                    digitGroupSeparator = separator;
                    break;
                }
            }

            let displayCharacteristics = `{"digitGroupSeparator":"${digitGroupSeparator}", "decimalSeparator":"${decimalSeparator}"}`;

            displayCharColumn.getCell(i, 0).setValue(displayCharacteristics);
        }
    }
}

function displayStatus(status: string, cellRange?: ExcelScript.Range) {
    if (!cellRange) {
        console.log(status);
    }

    cellRange.setValue(status);
}

function reapplySheetConfigurations(treateableWorksheets: TreateableWorksheet[]) {
    treateableWorksheets.forEach(treateableWorksheet => {
        // Apply protection settings back
        if (treateableWorksheet.options) {
            treateableWorksheet.sheet.getProtection().protect(treateableWorksheet.options);
        }
    });
}

function gatherAndClearSheetConfigurations(workbook: ExcelScript.Workbook): TreateableWorksheet[] {
    let treateableWorksheets: TreateableWorksheet[] = [];
    let worksheets = workbook.getWorksheets();

    // Remove protection from all worksheets if they are protected
    worksheets.forEach(sheet => {
        let protection = sheet.getProtection();

        if (protection.getProtected()) {
            // Store options directly without trying to create a reference to the API object
            let options: Partial<ExcelScript.WorksheetProtectionOptions> = {
                allowAutoFilter: protection.getOptions().allowAutoFilter,
                allowDeleteColumns: protection.getOptions().allowDeleteColumns,
                allowDeleteRows: protection.getOptions().allowDeleteRows,
                allowFormatCells: protection.getOptions().allowFormatCells,
                allowFormatColumns: protection.getOptions().allowFormatColumns,
                allowFormatRows: protection.getOptions().allowFormatRows,
                allowInsertColumns: protection.getOptions().allowInsertColumns,
                allowInsertHyperlinks: protection.getOptions().allowInsertHyperlinks,
                allowInsertRows: protection.getOptions().allowInsertRows,
                allowPivotTables: protection.getOptions().allowPivotTables,
                allowSort: protection.getOptions().allowSort,
            };

            try {
                // Unprotect the worksheet
                protection.unprotect(); // Directly use the method without aliasing

                let tables: TreatableTable[] = sheet.getTables().map(t => ({
                    tableName: t.getName()
                }));

                treateableWorksheets.push({
                    sheet: sheet,
                    tables: tables,
                    options: options
                });
            } catch (error) {
                console.log('Detected password protected sheet, skipping.');
            }
        } else {
            let tables: TreatableTable[] = sheet.getTables().map(t => ({
                tableName: t.getName()
            }));

            treateableWorksheets.push({
                sheet: sheet,
                tables: tables,
                options: null
            });
        }

    });

    return treateableWorksheets;
}

function tryParseFeaturesTable(workbook: ExcelScript.Workbook): Features {
    const table = workbook.getTable(FEATURES_TABLE_NAME);
    let features: Features = {
        conserveFormulas: false,
        conserveUniqueFormats: false,
        tryResolveOverflows: false,
        tryEnforceFormat: false,
        reevalFormulas: false
    };

    if (!table) {
        console.log(`Table ${FEATURES_TABLE_NAME} doesn't exist. Using default features.`);
        return features;
    }

    let featuresColumn = table.getColumnByName("Feature");
    let activeColumn = table.getColumnByName("Active");

    if (!featuresColumn || !activeColumn) {
        console.log(`Table ${FEATURES_TABLE_NAME} does not have the required columns.`);
        return features;
    }

    let featureNames = featuresColumn.getRangeBetweenHeaderAndTotal().getValues().map(row => row[0]);
    let activeValues = activeColumn.getRangeBetweenHeaderAndTotal().getValues().map(row => row[0]);
    let featuresDict = combineArraysToDictionary(featureNames, activeValues);

    features.conserveFormulas = featuresDict["Conserve formulas"] as boolean ?? false;
    features.conserveUniqueFormats = featuresDict["Conserve unique formats"] as boolean ?? false;
    features.tryResolveOverflows = featuresDict["Try resolving overflows"] as boolean ?? false;
    features.tryEnforceFormat = featuresDict["Try enforcing formats"] as boolean ?? false;
    features.reevalFormulas = featuresDict["Reevalulate formulas"] as boolean ?? false;

    return features;
}

function combineArraysToDictionary(keys: (string | number | boolean)[], values: (string | number | boolean)[]) {
    let dictionary = {};

    keys.forEach((key, index) => {
        dictionary[key.toString()] = values[index];
    });

    return dictionary;
}

function sleep(seconds: number) {
    var waitUntil = new Date().getTime() + seconds * 1000;
    while (new Date().getTime() < waitUntil) { };
}

function refreshQueriesAndWaitForCompletion(workbook: ExcelScript.Workbook, statusCell: ExcelScript.Range) {
    const startTime = new Date();
    const queryNames: string[] = workbook.getQueries().map(q => q["instance"]["m_name"]);
    let tableQueries: ExcelScript.Query[] = [];

    queryNames.forEach((name) => {
        let query = workbook.getQuery(name);
        if (query.getLoadedTo() == ExcelScript.LoadToType.table) {
            tableQueries.push(query);
        }
    });

    workbook.refreshAllDataConnections();

    // Bounded wait. This loop previously had no exit except every query reporting a refresh
    // date later than startTime - so a query whose table binding has desynced (its QueryTable
    // no longer connected, see CONTEXT.md) never reports and the script spins here forever.
    // Give up instead, and name the queries that never came back.
    while (tableQueries.length > 0) {
        if (new Date().getTime() - startTime.getTime() > REFRESH_TIMEOUT_SECONDS * 1000) {
            const stuck = tableQueries.map(q => q.getName()).join(", ");
            displayStatus(`Step 7/${TOTAL_STEPS}: Timed out after ${REFRESH_TIMEOUT_SECONDS}s waiting on: ${stuck}`, statusCell);
            console.log(`Refresh timed out. Queries that never reported completion: ${stuck}`);
            console.log("A query that never reports usually means a broken table/query binding - check the table's SourceType before retrying.");
            break;
        }

        tableQueries = tableQueries.filter(q => q.getRefreshDate() < startTime);
        const pendingNames = tableQueries.map(q => q.getName()).join(", ");
        displayStatus(`Step 7/${TOTAL_STEPS}: Refreshing external data. Waiting on: ${pendingNames || "none"}`, statusCell);

        if (tableQueries.length > 0) {
            sleep(REFRESH_POLL_SECONDS);
        }
    }
    debug("Finished Refreshing All Queries");
}